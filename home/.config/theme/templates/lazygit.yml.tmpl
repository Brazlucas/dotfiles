# lazygit — tema gerado por `theme` ({{label}}); carregado via LG_CONFIG_FILE
gui:
  theme:
    activeBorderColor: ['{{accent1}}', bold]
    inactiveBorderColor: ['{{dim}}']
    searchingActiveBorderColor: ['{{yellow}}', bold]
    optionsTextColor: ['{{accent2}}']
    selectedLineBgColor: ['{{sel}}']
    inactiveViewSelectedLineBgColor: ['{{bg_alt}}']
    selectedRangeBgColor: ['{{sel}}']
    cherryPickedCommitBgColor: ['{{magenta}}']
    cherryPickedCommitFgColor: ['{{accent2}}']
    unstagedChangesColor: ['{{accent1}}']
    defaultFgColor: ['{{fg}}']
  authorColors:
    '*': '{{accent2}}'
